<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPublishable>false</IsPublishable>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- GpuLz4Experiment only; nothing the server ships uses it. -->
    <PackageReference Include="ILGPU" Version="1.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BasisNetworkClient\BasisNetworkClient.csproj" />
    <ProjectReference Include="..\BasisNetworkCore\BasisNetworkCore.csproj" />
    <!-- Referenced for BasisHelloClient, which HelloWorldPeerMessageTests drives against a real server. -->
    <ProjectReference Include="..\BasisHelloWorldClient\BasisHelloWorldClient.csproj" />
    <ProjectReference Include="..\BasisNetworkServer\BasisNetworkServer.csproj" />
    <!-- Present so the runtime lookup under test has something to find; never referenced in code. -->
    <ProjectReference Include="..\BasisNetworkCompute\BasisNetworkCompute.csproj" />
    <ProjectReference Include="..\Contrib\Auth\Did\Did.csproj" />
    <ProjectReference Include="..\Contrib\Crypto\Crypto.csproj" />
    <ProjectReference Include="..\LiteNetLib\LiteNetLib.csproj" />
  </ItemGroup>

  <!--
    The iroh transport lives in the basis_iroh_ffi native library from the Rust workspace. It is
    copied beside the test assembly when a release build of it exists, so the mixed-world tests
    can run C# clients on iroh next to C# clients on LiteNetLib; without it those tests skip.
  -->
  <PropertyGroup>
    <BasisIrohFfiDir Condition="'$(BasisIrohFfiDir)' == ''">$(MSBuildThisFileDirectory)../../basis_server/target/release/</BasisIrohFfiDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(BasisIrohFfiDir)libbasis_iroh_ffi.so" Condition="Exists('$(BasisIrohFfiDir)libbasis_iroh_ffi.so')" Link="libbasis_iroh_ffi.so" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(BasisIrohFfiDir)libbasis_iroh_ffi.dylib" Condition="Exists('$(BasisIrohFfiDir)libbasis_iroh_ffi.dylib')" Link="libbasis_iroh_ffi.dylib" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(BasisIrohFfiDir)basis_iroh_ffi.dll" Condition="Exists('$(BasisIrohFfiDir)basis_iroh_ffi.dll')" Link="basis_iroh_ffi.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
